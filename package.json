{
  "name": "rush",
  "version": "0.0.1",
  "private": true,
  "description": "Ranger Unified Scheduling & Hours monorepo",
  "scripts": {
    "artisan": "php server/artisan",
    "server:migrate": "php server/artisan migrate",
    "server:migrate:status": "php server/artisan migrate:status",
    "server:migrate:rollback": "php server/artisan migrate:rollback",
    "server:migrate:fresh": "php server/artisan migrate:fresh",
    "server:seed": "php server/artisan db:seed",
    "server:cache:clear": "php server/artisan cache:clear",
    "server:config:clear": "php server/artisan config:clear",
    "server:route:clear": "php server/artisan route:clear",
    "server:view:clear": "php server/artisan view:clear",
    "server:optimize:clear": "php server/artisan optimize:clear",
    "server:optimize": "php server/artisan optimize",
    "server:config:cache": "php server/artisan config:cache",
    "server:route:cache": "php server/artisan route:cache",
    "server:view:cache": "php server/artisan view:cache",
    "server:key:generate": "php server/artisan key:generate",
    "server:storage:link": "php server/artisan storage:link",
    "server:queue:work": "php server/artisan queue:work",
    "server:queue:restart": "php server/artisan queue:restart",
    "server:queue:failed": "php server/artisan queue:failed",
    "server:queue:retry": "php server/artisan queue:retry",
    "server:schedule:list": "php server/artisan schedule:list",
    "server:schedule:run": "php server/artisan schedule:run",
    "server:schedule:work": "php server/artisan schedule:work",
    "server:route:list": "php server/artisan route:list",
    "server:up": "php server/artisan up",
    "server:down": "php server/artisan down",
    "conventions:lint": "node scripts/lint-conventions.mjs",
    "conventions:test": "node --test scripts/*.test.mjs",
    "client:build": "npm --prefix client run build",
    "client:build:pwa": "npm --prefix client run build:pwa",
    "client:lint": "npm --prefix client run lint:check",
    "client:test": "npm --prefix client run test:unit",
    "client:typecheck": "npm --prefix client run typecheck",
    "client:test:e2e": "npm --prefix client run test:e2e",
    "server:format": "composer --working-dir=server format:check",
    "server:test": "composer --working-dir=server test"
  }
}
