{$RUSH_SITE_ADDRESS:https://localhost} {
	encode zstd gzip

	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}

	@laravel path /admin* /api/v1* /up /vendor/orchid* /build* /storage* /login* /logout* /csrf-cookie /sanctum*

	handle @laravel {
		root * /var/www/html/public
		php_fastcgi server:9000
		file_server
	}

	handle /index.php* {
		respond "Not Found" 404
	}

	# Worker/manifest requests must return a real file, never the SPA fallback.
	@pwaFiles path /sw.js /manifest.json /workbox-*
	handle @pwaFiles {
		root * /srv/client
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv/client
		try_files {path} {path}/ /index.html
		file_server
	}
}
