{$RUSH_SITE_ADDRESS:https://localhost} {
	encode zstd gzip
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
	}

	@laravel path /admin* /api/v1* /up /vendor/orchid* /build* /storage* /login* /logout* /csrf-cookie /sanctum*
	handle @laravel {
		root * /var/www/html/public
		php_fastcgi server:9000
		file_server
	}

	handle /index.php* {
		respond "Not Found" 404
	}

	# Retire a previously installed production worker without clearing offline data.
	handle /sw.js {
		root * /srv/dev
		header Cache-Control "no-store"
		file_server
	}
	@pwaFiles path /manifest.json /workbox-*
	handle @pwaFiles {
		respond "Development uses the live SPA" 404
	}

	# Includes Vite's HMR WebSocket; only Caddy publishes a host port.
	handle {
		reverse_proxy client:9000
	}
}
